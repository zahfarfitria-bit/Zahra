    <script>
        function toast(msg, type='info') {
            const b = document.getElementById('toast-box'), t = document.createElement('div');
            t.className = `px-3 py-2 rounded-xl text-xs font-bold border shadow-xl bg-slate-800 text-white border-slate-700`;
            t.innerText = msg; b.appendChild(t);
            setTimeout(() => t.remove(), 2500);
        }

        function tab(id) {
            document.querySelectorAll('.tab-sec').forEach(s => s.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('tab-act'));
            document.getElementById(`tab-${id}`).classList.remove('hidden');
            document.getElementById(`nav-${id}`).classList.add('tab-act');
        }

        function toggleMobile() { document.getElementById('mob-nav').classList.toggle('hidden'); }

        const actx = new (window.AudioContext || window.webkitAudioContext)();
        function playTone(f, dur=0.2) {
            try {
                const o = actx.createOscillator(), g = actx.createGain();
                o.frequency.value = f; g.gain.setValueAtTime(0.1, actx.currentTime);
                g.gain.exponentialRampToValueAtTime(0.001, actx.currentTime + dur);
                o.connect(g); g.connect(actx.destination); o.start(); o.stop(actx.currentTime + dur);
            } catch(e) {}
        }
        function playNote(f, n) { playTone(f, 0.3); document.getElementById('music-note-txt').innerText = `🎵 Nada Piano: ${n} (${f}Hz)`; }

        const items = [
            { id: 'coffee', name: 'Espresso', price: 15000, icon: '☕' },
            { id: 'boba', name: 'Boba Tea', price: 20000, icon: '🧋' },
            { id: 'cake', name: 'Slice Cake', price: 25000, icon: '🍰' },
            { id: 'ramen', name: 'Ramen', price: 18000, icon: '🍜' }
        ];

        let gMoney=0, gScore=0, activeCust=null, preparedTray=[], changeEntered=0, gTimer=null, pTime=100;

        function initGame() {
            gMoney=0; gScore=0; updateStats(); spawnCust();
        }

        function updateStats() {
            document.getElementById('gm-money').innerText = `Rp ${gMoney.toLocaleString('id-ID')}`;
            document.getElementById('gm-score').innerText = gScore;
        }

        function spawnCust() {
            clearInterval(gTimer); preparedTray=[]; changeEntered=0; renderTray(); renderChange();
            const cItem = items[Math.floor(Math.random() * items.length)];
            const cash = Math.ceil((cItem.price + 5000) / 10000) * 10000;
            activeCust = { item: cItem, total: cItem.price, cash: cash, targetChange: cash - cItem.price };

            document.getElementById('gm-cust-total').innerText = `Rp ${activeCust.total.toLocaleString('id-ID')}`;
            document.getElementById('gm-cust-cash').innerText = `Rp ${activeCust.cash.toLocaleString('id-ID')}`;
            document.getElementById('gm-target-change').innerText = `Rp ${activeCust.targetChange.toLocaleString('id-ID')}`;
            document.getElementById('gm-order-badges').innerHTML = `<span class="bg-purple-900/60 px-2 py-0.5 rounded text-purple-200 border border-purple-500/30">${cItem.icon} ${cItem.name}</span>`;

            pTime = 100;
            gTimer = setInterval(() => {
                pTime -= 2.5;
                document.getElementById('gm-bar').style.width = `${pTime}%`;
                document.getElementById('gm-timer').innerText = `Kesabaran: ${Math.max(0, Math.round(pTime))}%`;
                if (pTime <= 0) {
                    clearInterval(gTimer);
                    toast("😡 Pembeli Kabur Karena Lama!", "error");
                    gScore = Math.max(0, gScore - 10); updateStats(); spawnCust();
                }
            }, 600);
        }

        function addGameRecipe(id) {
            const it = items.find(i => i.id === id);
            if (it) { preparedTray.push(it); playTone(500); renderTray(); }
        }
        function clearGameTray() { preparedTray = []; renderTray(); }
        function renderTray() {
            const el = document.getElementById('gm-tray'); el.innerHTML = '';
            if(!preparedTray.length) { el.innerHTML = '<span class="text-[10px] text-slate-500 italic">Baki kosong</span>'; return; }
            preparedTray.forEach(i => el.innerHTML += `<span class="bg-emerald-900/60 px-1.5 py-0.5 rounded text-emerald-200 border border-emerald-500/30">${i.icon} ${i.name}</span>`);
        }

        function addGameChange(amt) { changeEntered += amt; playTone(400); renderChange(); }
        function clearGameChange() { changeEntered = 0; renderChange(); }
        function renderChange() { document.getElementById('gm-input-change').value = `Rp ${changeEntered.toLocaleString('id-ID')}`; }

        function submitGame() {
            if(!activeCust) return;
            const itemMatch = preparedTray.length === 1 && preparedTray[0].id === activeCust.item.id;
            const changeMatch = changeEntered === activeCust.targetChange;

            if(!itemMatch) { toast("❌ Pesanan di Baki Salah!", "error"); return; }
            if(!changeMatch) { toast("❌ Kembalian Salah!", "error"); return; }

            clearInterval(gTimer);
            gMoney += activeCust.total; gScore += 25; updateStats();
            playTone(800, 0.3);
            if(typeof confetti === 'function') confetti({ particleCount: 30 });
            toast("🎉 Sukses Melayani Pembeli! (+25 Skor)", "success");
            spawnCust();
        }

        let posCart = [];
        function renderPos() {
            const g = document.getElementById('pos-grid'); g.innerHTML = '';
            items.forEach(it => {
                g.innerHTML += `
                    <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 flex flex-col justify-between text-xs">
                        <div class="text-center mb-1"><span class="text-2xl">${it.icon}</span><h4 class="font-bold text-white text-[11px]">${it.name}</h4><span class="text-emerald-400 font-extrabold text-[10px]">Rp ${it.price.toLocaleString('id-ID')}</span></div>
                        <button onclick="addPos(${it.id})" class="btn-act bg-emerald-500 text-slate-950 font-black py-1 rounded-lg text-[10px]">+ Tambah</button>
                    </div>`;
            });
        }

        function addPos(id) {
            const it = items.find(i => i.id === id);
            const ex = posCart.find(c => c.id === id);
            if(ex) ex.qty++; else posCart.push({...it, qty: 1});
            playTone(600); renderCart();
        }

        function clearPosCart() { posCart = []; renderCart(); }
        function renderCart() {
            const list = document.getElementById('pos-cart-list'); list.innerHTML = '';
            let tot = 0;
            posCart.forEach(c => {
                tot += c.price * c.qty;
                list.innerHTML += `<div class="flex justify-between items-center bg-slate-900 p-1.5 rounded text-[11px]"><span>${c.icon} ${c.name} x${c.qty}</span><strong class="text-emerald-400">Rp ${(c.price*c.qty).toLocaleString('id-ID')}</strong></div>`;
            });
            document.getElementById('pos-total').innerText = `Rp ${tot.toLocaleString('id-ID')}`;
        }

        function openPosModal() {
            if(!posCart.length) { toast("Keranjang kosong!", "warning"); return; }
            const tot = posCart.reduce((a,c) => a + (c.price*c.qty), 0);
            document.getElementById('pos-modal-tot').innerText = `Rp ${tot.toLocaleString('id-ID')}`;
            document.getElementById('pos-modal').classList.remove('hidden');
        }
        function closePosModal() { document.getElementById('pos-modal').classList.add('hidden'); }

        function processPos() {
            const tot = posCart.reduce((a,c) => a + (c.price*c.qty), 0);
            const cash = parseInt(document.getElementById('pos-cash-in').value) || 0;
            if(cash < tot) { toast("Uang tunai kurang!", "error"); return; }

            document.getElementById('rec-tot').innerText = `Rp ${tot.toLocaleString('id-ID')}`;
            document.getElementById('rec-paid').innerText = `Rp ${cash.toLocaleString('id-ID')}`;
            document.getElementById('rec-change').innerText = `Rp ${(cash - tot).toLocaleString('id-ID')}`;

            const rItems = document.getElementById('rec-items'); rItems.innerHTML = '';
            posCart.forEach(c => rItems.innerHTML += `<div class="flex justify-between"><span>${c.name} x${c.qty}</span><span>Rp ${(c.price*c.qty).toLocaleString('id-ID')}</span></div>`);

            closePosModal();
            document.getElementById('rec-modal').classList.remove('hidden');
            clearPosCart();
        }
        function closeRecModal() { document.getElementById('rec-modal').classList.add('hidden'); }

        window.onload = function() {
            initGame(); renderPos();
        };
    </script>
</body>
</html>

